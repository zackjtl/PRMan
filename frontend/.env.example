# 前端僅讀本檔（與 vite.config.ts 同目錄）。變數必須以 VITE_ 開頭才會進瀏覽器。
# 須與後端指向同一套 Supabase（Zeabur：Kong Variables / Domains）。
VITE_SUPABASE_URL=https://your-supabase-api.example.com
VITE_SUPABASE_ANON_KEY=your_anon_key

# 選用：已部署的後端網址（勿尾隨 /）。本機開發請留空或刪除此行，以使用 Vite /api proxy。
# VITE_API_BASE_URL=https://prman-api.jlai81.net
